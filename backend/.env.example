# Server bind address (0.0.0.0 = listen on all interfaces)
HOST=0.0.0.0

# Server port (old pyautogui backend uses 9281)
PORT=9282

# Auto-reload on code changes. Keep false: a reload restarts Chrome.
RELOAD=false

# Comma-separated allowed CORS origins, or * for all
CORS_ORIGINS=*

# Open Chrome + YouTube as soon as the server starts
LAUNCH_ON_START=true

# Chrome is started once as a normal browser with a debug port and Selenium
# attaches to it, so it stays open (tabs, sign-in) across backend restarts.
# If Chrome is already listening on this port, the backend just attaches.
CHROME_DEBUG_PORT=9222

# Profile for that Chrome (sign in to YouTube here once). Chrome refuses remote
# control of your default profile, so this must be a separate folder.
# Default: %LOCALAPPDATA%\YouTubeRemote\chrome-profile
# CHROME_PROFILE_DIR=

# Optional custom Chrome binary (auto-detected otherwise)
# CHROME_BINARY=

# Address the QR code tab points phones to (default: this PC's LAN IP, port 9283)
# FRONTEND_URL=http://10.0.0.11:9283

# Your Jellyfin server (sign in once in the remote's Chrome)
JELLYFIN_URL=https://streaming.thatinsaneguy.com

# Press Skip (ads, intros, recaps, credits) by itself as soon as a site offers it.
AUTO_SKIP=true

# Power off by itself (park the tabs, back to the Home/QR screen) after this
# many minutes with nothing playing and no command from any phone.
IDLE_SLEEP=true
IDLE_SLEEP_MINUTES=10
